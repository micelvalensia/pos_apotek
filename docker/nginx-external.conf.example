# Nginx External Configuration Example
# File ini adalah contoh konfigurasi untuk nginx yang berada DI LUAR Docker
# (nginx yang menerima traffic dari Cloudflare dan meneruskan ke Docker)

# Scenario 1: Nginx eksternal tanpa SSL (Cloudflare Flexible SSL)
# Cloudflare handle SSL, nginx eksternal terima HTTP dari Cloudflare
server {
    listen 80;
    server_name pos.micel.dev;

    # Logging
    access_log /var/log/nginx/pos-access.log;
    error_log /var/log/nginx/pos-error.log;

    location / {
        # Proxy ke Docker nginx (adjust port sesuai docker-compose.yml)
        proxy_pass http://localhost:8000;
        
        # Basic proxy headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        
        # CRITICAL: Force HTTPS headers karena Cloudflare sudah SSL
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        
        # Timeout settings
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}

# Scenario 2: Nginx eksternal dengan SSL (Cloudflare Full SSL)
# Nginx handle SSL sendiri, Cloudflare kirim HTTPS ke nginx
server {
    listen 80;
    server_name pos.micel.dev;
    
    # Redirect HTTP ke HTTPS
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name pos.micel.dev;

    # SSL Configuration (gunakan cert dari Cloudflare Origin CA)
    ssl_certificate /etc/ssl/certs/pos.micel.dev.pem;
    ssl_certificate_key /etc/ssl/private/pos.micel.dev.key;
    
    # SSL Security
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # Logging
    access_log /var/log/nginx/pos-ssl-access.log;
    error_log /var/log/nginx/pos-ssl-error.log;

    location / {
        # Proxy ke Docker nginx
        proxy_pass http://localhost:8000;
        
        # Proxy headers - scheme akan otomatis 'https'
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;  # Otomatis 'https'
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;  # Otomatis 443
        
        # WebSocket support (jika diperlukan untuk Vite HMR)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        
        # Timeout settings
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}

# Deployment Instructions:
# 1. Copy file ini ke /etc/nginx/sites-available/pos-apotek
# 2. Edit server_name dan proxy_pass sesuai kebutuhan
# 3. Jika pakai SSL, generate certificate dan update path
# 4. Create symlink: sudo ln -s /etc/nginx/sites-available/pos-apotek /etc/nginx/sites-enabled/
# 5. Test config: sudo nginx -t
# 6. Reload nginx: sudo systemctl reload nginx
